# Copie para .env (gitignored) e preencha com valores reais para rodar localmente.
# Em produção, DATABASE_URL vem do Key Vault via variável de ambiente do Container App.
DATABASE_URL=postgresql://asafadmin:SENHA_AQUI@asaf-pg-server.postgres.database.azure.com:5432/asaf_db?sslmode=require

# Dev local (HTTP): o cookie de refresh é HttpOnly + Secure por padrão. Um cookie Secure
# não é gravado pelo navegador em http://localhost — desligue aqui só para desenvolver.
COOKIE_SECURE=false

# Origens permitidas no CORS: painel + site institucional (dev do Vite/Astro + produção). Separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4321,http://127.0.0.1:4321,https://painel.asaf.org.br,https://asaf.org.br
