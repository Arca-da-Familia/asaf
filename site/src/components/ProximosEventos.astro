---
import { API_URL } from '../config/organizacao'

interface Props {
  /** "futuros" (padrão) = próximos eventos; "passados" = arquivo dos que já aconteceram. */
  modo?: 'futuros' | 'passados'
  /** Id da seção (âncora). */
  id?: string
  titulo?: string
  /** Ids com página própria no site publicado: só esses viram link (senão seria um 404). */
  idsComPagina?: number[]
}

const {
  modo = 'futuros',
  id = 'eventos',
  titulo = 'Próximos eventos',
  idsComPagina = [],
} = Astro.props
---

<section
  id={id}
  aria-labelledby={`${id}-titulo`}
  class="mx-auto max-w-5xl scroll-mt-4 px-4 py-12"
>
  <h2 id={`${id}-titulo`} class="text-2xl font-bold tracking-tight">
    {titulo}
  </h2>
  <!--
    Ilha (v5.0): o HTML sai pronto do build; os eventos são buscados na API no navegador, a
    cada visita (src/lib/eventos-dom.ts). Evento novo aparece sem rebuild do site.
  -->
  <div
    data-eventos
    data-modo={modo}
    data-api-url={API_URL}
    data-ids-com-pagina={idsComPagina.join(',')}
    aria-live="polite"
    aria-busy="true"
    class="mt-6"
  >
    <p class="text-muted-foreground" data-estado="carregando">
      Carregando eventos…
    </p>
  </div>
  <noscript>
    <p class="mt-6 text-muted-foreground">
      Ative o JavaScript do navegador para ver os eventos.
    </p>
  </noscript>
</section>

<script>
  import { iniciarEventos } from '../lib/eventos-dom'

  document
    .querySelectorAll<HTMLElement>('[data-eventos]')
    .forEach((container) => void iniciarEventos(container))
</script>
