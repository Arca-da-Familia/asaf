---
import type { Migalha } from '../config/navegacao'

interface Props {
  titulo: string
  /** Frase de apresentação da página (aparece sob o título). */
  resumo?: string
  /** Trilha sem a "Início" — a mesma passada ao <Base migalhas=...> (dado estruturado). */
  migalhas?: Migalha[]
}

const { titulo, resumo, migalhas = [] } = Astro.props
---

<section class="bg-primary text-primary-foreground">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
    {migalhas.length > 0 && (
      <nav aria-label="Você está em" class="mb-4 text-sm">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <li>
            <a href="/" class="underline">
              Início
            </a>
          </li>
          {migalhas.map((migalha) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">›</span>
              {migalha.href ? (
                <a href={migalha.href} class="underline">
                  {migalha.rotulo}
                </a>
              ) : (
                <span aria-current="page">{migalha.rotulo}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{titulo}</h1>
    <div class="mt-4 h-1 w-16 rounded bg-brand-secondary"></div>
    {resumo && <p class="mt-4 max-w-3xl text-lg">{resumo}</p>}
  </div>
</section>
