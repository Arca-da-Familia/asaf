---
import { ORGANIZACAO, PAINEL_URL } from '../config/organizacao'
---

<header class="border-b bg-background">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3"
  >
    <a href="/" class="flex items-center gap-2 font-semibold">
      <svg
        viewBox="0 0 32 32"
        class="h-8 w-8 shrink-0"
        aria-hidden="true"
        focusable="false"
      >
        <rect width="32" height="32" rx="6" fill="#2563eb"></rect>
        <text
          x="16"
          y="22"
          text-anchor="middle"
          font-family="system-ui, sans-serif"
          font-size="18"
          font-weight="700"
          fill="#fff">A</text
        >
      </svg>
      <span>{ORGANIZACAO.sigla}</span>
      <span class="hidden font-normal text-muted-foreground sm:inline"
        >— {ORGANIZACAO.nome}</span
      >
    </a>
    <nav aria-label="Principal">
      <ul class="flex items-center gap-4 text-sm font-medium">
        <li><a href="/#eventos" class="hover:underline">Eventos</a></li>
        <li>
          <a
            href={PAINEL_URL}
            class="rounded-md bg-primary px-3 py-2 text-primary-foreground hover:opacity-90"
            >Área do associado</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>
