---
import { NAVEGACAO_PRINCIPAL, ehPaginaAtual } from '../config/navegacao'
import { LOGO, ORGANIZACAO, PAINEL_URL } from '../config/organizacao'

// Altura fixa de 44px; a largura sai da proporção real da logo (sem salto de layout).
const ALTURA = 44
const LARGURA = Math.round(ALTURA * LOGO.proporcao)

const caminhoAtual = Astro.url.pathname
---

<header class="border-b bg-background">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3">
    <a href="/" class="flex items-center gap-3 font-semibold">
      <!-- alt vazio: o nome ao lado já é o texto do link; a logo é decorativa aqui -->
      <img
        src={LOGO.cabecalho}
        alt=""
        width={LARGURA}
        height={ALTURA}
        class="h-11 w-auto shrink-0"
      />
      <span>{ORGANIZACAO.sigla}</span>
      <span class="hidden font-normal text-muted-foreground xl:inline">
        — {ORGANIZACAO.nome}
      </span>
    </a>

    <!-- Computador: menu em linha. -->
    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-4 text-sm font-medium xl:gap-5">
        {NAVEGACAO_PRINCIPAL.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={
                ehPaginaAtual(item.href, caminhoAtual) ? 'page' : undefined
              }
              class="py-2 hover:underline aria-[current=page]:underline aria-[current=page]:decoration-brand-secondary aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
            >
              {item.rotulo}
            </a>
          </li>
        ))}
        <li>
          <a
            href={PAINEL_URL}
            class="rounded-md bg-primary px-3 py-2 text-primary-foreground hover:opacity-90"
          >
            Área do associado
          </a>
        </li>
      </ul>
    </nav>

    <!-- Celular: o mesmo menu num <details> (funciona sem JavaScript e com teclado). -->
    <details class="group relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border px-3 py-2 text-sm font-medium [&::-webkit-details-marker]:hidden">
        Menu
        <span aria-hidden="true" class="group-open:hidden">
          ☰
        </span>
        <span aria-hidden="true" class="hidden group-open:inline">
          ✕
        </span>
      </summary>
      <nav
        aria-label="Principal (celular)"
        class="absolute right-0 z-40 mt-2 w-64 rounded-lg border bg-card p-2 shadow-card-hover"
      >
        <ul class="flex flex-col text-sm font-medium">
          {NAVEGACAO_PRINCIPAL.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  ehPaginaAtual(item.href, caminhoAtual) ? 'page' : undefined
                }
                class="block rounded-md px-3 py-3 hover:bg-accent aria-[current=page]:bg-accent"
              >
                {item.rotulo}
              </a>
            </li>
          ))}
          <li class="mt-1 border-t pt-2">
            <a
              href={PAINEL_URL}
              class="block rounded-md bg-primary px-3 py-3 text-center text-primary-foreground hover:opacity-90"
            >
              Área do associado
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
