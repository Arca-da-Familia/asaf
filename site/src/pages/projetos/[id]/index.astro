---
import EdicoesEEventos from '../../../components/contexto/EdicoesEEventos.astro'
import GaleriaDeFotos from '../../../components/contexto/GaleriaDeFotos.astro'
import NoticiasRelacionadas from '../../../components/contexto/NoticiasRelacionadas.astro'
import RelatoriosEDocumentos from '../../../components/contexto/RelatoriosEDocumentos.astro'
import SeloDeStatus from '../../../components/SeloDeStatus.astro'
import TituloDePagina from '../../../components/TituloDePagina.astro'
import type { Migalha } from '../../../config/navegacao'
import { ORGANIZACAO } from '../../../config/organizacao'
import Base from '../../../layouts/Base.astro'
import {
  noticiasDoProjeto,
  soComPagina,
  soDocumentosPublicados,
} from '../../../lib/contexto'
import {
  caminhoDoProjeto,
  conteudoPublico,
  type NoticiaPublica,
  type ProjetoDetalhado,
  type ProjetoPublico,
} from '../../../lib/dados-publicos'
import { formatarDataCurta } from '../../../lib/datas'
import { descricaoParaMeta, tituloCurto } from '../../../lib/texto'

// Uma página por projeto público, com URL estável (/projetos/<id>/) — só o id, para um título
// editado nunca quebrar um link já compartilhado.
//
// v5.5: além do projeto, a página mostra o que está ligado a ele no sistema — edições (eventos), relatórios e
// documentos aprovados, fotos (com autorização de imagem) — e as notícias do Directus ligadas pelo número. Cada
// seção SÓ existe quando há conteúdo: nada de "Fotos" vazio.
export async function getStaticPaths() {
  const { projetos, eventos, documentos, detalhesDeProjetos, noticias } =
    await conteudoPublico()
  return projetos.map((projeto) => {
    const detalhe = detalhesDeProjetos[projeto.id_projeto]!
    // Só o que tem página no site vira link (nunca um 404): o evento da lista de eventos e o documento da lista de
    // documentos publicados.
    const edicoes = soComPagina(
      detalhe.eventos,
      eventos.map((e) => e.id_evento),
    )
    const { lista, total } = noticiasDoProjeto(
      noticias,
      projeto.id_projeto,
      edicoes.map((e) => e.id_evento),
    )
    return {
      params: { id: String(projeto.id_projeto) },
      props: {
        projeto,
        detalhe: {
          ...detalhe,
          eventos: edicoes,
          documentos: soDocumentosPublicados(detalhe.documentos, documentos),
        },
        noticias: lista,
        haMaisNoticias: total > lista.length,
      },
    }
  })
}

interface Props {
  projeto: ProjetoPublico
  detalhe: ProjetoDetalhado
  noticias: NoticiaPublica[]
  haMaisNoticias: boolean
}
const { projeto, detalhe, noticias, haMaisNoticias } = Astro.props
// Título de cada edição: legenda das fotos e "a que edição o relatório pertence".
const titulosDosEventos = Object.fromEntries(
  detalhe.eventos.map((e) => [e.id_evento, e.titulo]),
)

const migalhas: Migalha[] = [
  { rotulo: 'Projetos', href: '/projetos/' },
  { rotulo: tituloCurto(projeto.nome) },
]
const reserva = `Projeto ${projeto.nome} da ${ORGANIZACAO.nome} (${ORGANIZACAO.sigla}), em ${ORGANIZACAO.cidade} (${ORGANIZACAO.uf}).`
---

<Base
  titulo={tituloCurto(projeto.nome)}
  descricao={descricaoParaMeta(projeto.descricao, reserva)}
  caminho={caminhoDoProjeto(projeto.id_projeto)}
  migalhas={migalhas}
>
  <TituloDePagina titulo={projeto.nome} migalhas={migalhas} />

  <div class="mx-auto flex max-w-5xl flex-col gap-10 px-4 py-12">
    <p>
      <SeloDeStatus codigo={projeto.status_codigo} rotulo={projeto.status} />
    </p>

    {projeto.descricao && (
      <section aria-labelledby="sobre">
        <h2 id="sobre" class="text-2xl font-bold tracking-tight">
          Sobre o projeto
        </h2>
        <p class="mt-4 max-w-3xl whitespace-pre-line leading-relaxed">
          {projeto.descricao}
        </p>
      </section>
    )}

    <section aria-labelledby="detalhes">
      <h2 id="detalhes" class="text-2xl font-bold tracking-tight">
        Em resumo
      </h2>
      <dl class="mt-4 grid max-w-3xl gap-x-8 gap-y-3 sm:grid-cols-[auto_1fr]">
        {projeto.tipo && (
          <>
            <dt class="font-medium">Tipo</dt>
            <dd>{projeto.tipo}</dd>
          </>
        )}
        {projeto.publico_alvo && (
          <>
            <dt class="font-medium">Para quem</dt>
            <dd>{projeto.publico_alvo}</dd>
          </>
        )}
        {projeto.data_inicio && (
          <>
            <dt class="font-medium">Início</dt>
            <dd>{formatarDataCurta(projeto.data_inicio)}</dd>
          </>
        )}
        {projeto.data_fim_prevista && (
          <>
            <dt class="font-medium">Previsão de término</dt>
            <dd>{formatarDataCurta(projeto.data_fim_prevista)}</dd>
          </>
        )}
        {projeto.status && (
          <>
            <dt class="font-medium">Situação</dt>
            <dd>{projeto.status}</dd>
          </>
        )}
      </dl>
    </section>

    {detalhe.eventos.length > 0 && (
      <EdicoesEEventos
        id="edicoes"
        titulo="Edições e eventos"
        eventos={detalhe.eventos}
      />
    )}

    {detalhe.documentos.length > 0 && (
      <RelatoriosEDocumentos
        id="relatorios-e-documentos"
        titulo="Relatórios e documentos"
        documentos={detalhe.documentos}
        titulosDosEventos={titulosDosEventos}
      />
    )}

    {detalhe.fotos.length > 0 && (
      <GaleriaDeFotos
        id="fotos"
        titulo="Fotos"
        fotos={detalhe.fotos}
        titulosDosEventos={titulosDosEventos}
      />
    )}

    {noticias.length > 0 && (
      <NoticiasRelacionadas
        id="noticias"
        titulo="Notícias"
        noticias={noticias}
        haMais={haMaisNoticias}
      />
    )}

    <section
      aria-labelledby="participar"
      class="rounded-lg border bg-card p-6 shadow-card sm:p-8"
    >
      <h2 id="participar" class="text-xl font-bold tracking-tight">
        Quer ajudar?
      </h2>
      <p class="mt-2 max-w-2xl">
        Você pode dedicar o seu tempo como voluntário ou apoiar a ASAF de outras
        formas.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href="/seja-voluntario/"
          class="rounded-md bg-primary px-5 py-3 font-medium text-primary-foreground hover:opacity-90"
        >
          Seja voluntário
        </a>
        <a
          href="/como-ajudar/"
          class="rounded-md border px-5 py-3 font-medium hover:bg-accent"
        >
          Outras formas de ajudar
        </a>
      </div>
    </section>

    <p>
      <a
        href="/projetos/"
        class="font-medium text-primary underline underline-offset-4"
      >
        ← Todos os projetos
      </a>
    </p>
  </div>
</Base>
