---
import CartaoDeMembro from '../../components/CartaoDeMembro.astro'
import TituloDePagina from '../../components/TituloDePagina.astro'
import type { Migalha } from '../../config/navegacao'
import Base from '../../layouts/Base.astro'
import { conteudoPublico } from '../../lib/dados-publicos'
import {
  MEMBROS_DO_CONSELHO,
  montarComposicao,
  type CargoComOcupantes,
} from '../../lib/diretoria'

// Cargos: ESTATUTO (Art. 19 e Art. 24). Ocupantes: GET /api/publico/diretoria — só mandatos VIGENTES, só nome, cargo,
// órgão, datas do mandato e, de quem AUTORIZOU o uso da imagem, a foto (nunca CPF, e-mail ou telefone; v5.7c). Nenhum nome é
// digitado à mão aqui: se a diretoria muda no sistema (posse, vacância, foto nova ou retirada), o site é reconstruído sozinho
// (workflow sincronizar-site) e o cargo se preenche. A foto é a cópia que o build guardou no próprio site, nunca a da API.
const { diretoria } = await conteudoPublico()
const composicao = montarComposicao(diretoria)
const migalhas: Migalha[] = [{ rotulo: 'Diretoria e Conselho' }]

const orgaos: {
  id: string
  nome: string
  intro: string
  cargos: CargoComOcupantes[]
}[] = [
  {
    id: 'diretoria-executiva',
    nome: 'Diretoria Executiva',
    intro: 'Os sete cargos do Art. 19 do Estatuto.',
    cargos: composicao.diretoria,
  },
  {
    id: 'conselho-fiscal',
    nome: 'Conselho Fiscal',
    intro: `Os ${MEMBROS_DO_CONSELHO} membros do Art. 24 do Estatuto.`,
    cargos: composicao.conselho,
  },
]
---

<Base
  titulo="Diretoria e Conselho Fiscal"
  descricao="Quem dirige e quem fiscaliza a ASAF: os cargos da Diretoria Executiva e do Conselho Fiscal, previstos no Estatuto, e quem os ocupa no mandato atual."
  caminho="/diretoria/"
  migalhas={migalhas}
>
  <TituloDePagina
    titulo="Diretoria e Conselho Fiscal"
    resumo="Os cargos previstos no Estatuto e quem os ocupa no mandato atual."
    migalhas={migalhas}
  />

  <div class="mx-auto flex max-w-5xl flex-col gap-14 px-4 py-12">
    {!composicao.temOcupantes && (
      <section
        aria-labelledby="sem-composicao"
        class="rounded-lg border bg-card p-6 shadow-card sm:p-8"
        data-estado="vazio"
      >
        <h2 id="sem-composicao" class="text-xl font-bold tracking-tight">
          A composição atual ainda não foi publicada
        </h2>
        <p class="mt-2 max-w-3xl">
          Os cargos da Diretoria Executiva e do Conselho Fiscal são preenchidos
          por escrutínio secreto em Assembleia Geral (Estatuto, Art. 18). Quando
          a composição vigente for registrada no sistema da ASAF, o nome de cada
          ocupante aparece aqui automaticamente, no cargo correspondente.
        </p>
      </section>
    )}

    {orgaos.map((orgao) => (
      <section aria-labelledby={orgao.id} data-orgao={orgao.nome}>
        <h2 id={orgao.id} class="text-2xl font-bold tracking-tight">
          {orgao.nome}
        </h2>
        <p class="mt-2 text-sm text-muted-foreground">{orgao.intro}</p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {orgao.cargos.map((cargo) =>
            cargo.ocupantes.length === 0 ? (
              <li class="rounded-lg border border-dashed bg-card p-5" data-vaga>
                <p class="text-sm font-medium text-primary">
                  {cargo.assento.rotulo}
                </p>
                <p class="mt-1 text-base text-muted-foreground">
                  Ocupante ainda não publicado
                </p>
                <p class="mt-2 text-sm text-muted-foreground">
                  Cargo previsto no Estatuto ({cargo.assento.artigo}).
                </p>
              </li>
            ) : (
              cargo.ocupantes.map((membro) => (
                <CartaoDeMembro
                  membro={membro}
                  cargo={cargo.assento.rotulo}
                  destaque={cargo.destaque}
                />
              ))
            ),
          )}
        </ul>
      </section>
    ))}

    {composicao.outros.length > 0 && (
      <section aria-labelledby="outros" data-orgao="Outros cargos">
        <h2 id="outros" class="text-2xl font-bold tracking-tight">
          Outros cargos
        </h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {composicao.outros.map((membro) => (
            <CartaoDeMembro
              membro={membro}
              cargo={`${membro.cargo} · ${membro.orgao}`}
            />
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="como">
      <h2 id="como" class="text-2xl font-bold tracking-tight">
        Como a diretoria é composta
      </h2>
      <ul class="mt-4 flex max-w-3xl list-disc flex-col gap-3 pl-6">
        <li>
          A <strong>Diretoria Executiva</strong> tem sete cargos: Presidente, 1º
          e 2º Vice-Presidentes, 1º e 2º Secretários e 1º e 2º Tesoureiros (Art.
          19).
        </li>
        <li>
          O <strong>Conselho Fiscal</strong> é composto por três membros e
          fiscaliza toda a movimentação financeira e contábil (Art. 24).
        </li>
        <li>
          Os cargos são preenchidos por escrutínio secreto em Assembleia Geral,
          de quatro em quatro anos, na primeira quinzena de fevereiro, e os
          mandatos duram quatro anos (Arts. 18, 25 e 32).
        </li>
        <li data-sobre-as-fotos>
          A foto só é publicada de quem autorizou o uso da imagem; quem não tem
          foto publicada aparece com o nome, o cargo e as iniciais no lugar dela
          (veja a{' '}
          <a
            href="/privacidade/"
            class="font-medium text-primary underline underline-offset-4"
          >
            Política de Privacidade
          </a>
          ).
        </li>
      </ul>
      <p class="mt-6">
        <a
          href="/estatuto/#capitulo-v"
          class="font-medium text-primary underline underline-offset-4"
        >
          Leia o Capítulo V do Estatuto, “Dos órgãos da associação” →
        </a>
      </p>
    </section>
  </div>
</Base>
