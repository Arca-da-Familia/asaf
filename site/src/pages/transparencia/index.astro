---
import FaleConosco from '../../components/FaleConosco.astro'
import TituloDePagina from '../../components/TituloDePagina.astro'
import type { Migalha } from '../../config/navegacao'
import { ENDERECO_LINHA } from '../../config/organizacao'
import Base from '../../layouts/Base.astro'
import {
  caminhoDaAssembleia,
  conteudoPublico,
  organizacaoDoSite,
} from '../../lib/dados-publicos'
import { formatarDataCurta, formatarDia, formatarHora } from '../../lib/datas'
import {
  caminhoDoDocumento,
  ehEmenda,
  formatarReais,
} from '../../lib/transparencia'

// os dados da associação como o site os mostra: os fixos, com o que a Instituição do painel marcou "vai para o site" por cima (v5.4h)
const ORGANIZACAO = await organizacaoDoSite()

// Fontes: Estatuto Social (Arts. 1º, 5º, 8º, 20, 23, 24 e 28), dados institucionais confirmados pelo
// usuário (CNPJ, sede, contato), GET /api/publico/assembleias (editais de assembleia JÁ convocada) e, desde a
// v5.4b, o que a diretoria APROVOU no sistema: emendas, parcerias e documentos. Só é listado como "publicado" o que
// de fato existe — nunca prometido antes de existir.
const { assembleias, parcerias, documentos } = await conteudoPublico()
const emendas = parcerias.filter(ehEmenda)
const demaisParcerias = parcerias.filter((p) => !ehEmenda(p))
const somaRecebido = (lista: typeof parcerias) =>
  Math.round(lista.reduce((total, p) => total + p.recebido, 0) * 100) / 100
const maisRecentes = [...documentos]
  .sort((a, b) => (b.aprovado_em ?? '').localeCompare(a.aprovado_em ?? ''))
  .slice(0, 6)
const migalhas: Migalha[] = [{ rotulo: 'Transparência' }]

const etapasDeContas = [
  {
    quem: 'Diretoria Executiva',
    o_que:
      'Elabora o orçamento anual e apresenta à Assembleia Geral o relatório anual de sua gestão e a prestação de contas do exercício anterior.',
    artigo: 'Art. 20, III e IV',
  },
  {
    quem: 'Tesouraria',
    o_que:
      'O 1º Tesoureiro apresenta ao Conselho Fiscal os balancetes semestrais e o balanço anual, e organiza o relatório do balanço financeiro e dos principais eventos do ano anterior para a Assembleia Geral Ordinária.',
    artigo: 'Art. 23, V e VI',
  },
  {
    quem: 'Conselho Fiscal',
    o_que:
      'Examina os livros de escrituração, requisita a documentação das operações e dá pareceres sobre os balanços e relatórios, que são submetidos à Assembleia Geral.',
    artigo: 'Art. 24',
  },
  {
    quem: 'Assembleia Geral Ordinária',
    o_que:
      'Delibera sobre a previsão orçamentária e a prestação de contas. Reúne-se semestralmente, na primeira quinzena de fevereiro e de agosto.',
    artigo: 'Art. 5º, I, e Art. 8º, I, c',
  },
]
---

<Base
  titulo="Transparência"
  descricao="Informações públicas da ASAF: dados da entidade, Estatuto, como a diretoria presta contas e quem fiscaliza as contas da associação."
  caminho="/transparencia/"
  migalhas={migalhas}
>
  <TituloDePagina
    titulo="Transparência"
    resumo="Quem somos juridicamente, como as contas são fiscalizadas e quais documentos estão publicados."
    migalhas={migalhas}
  />

  <div class="mx-auto flex max-w-5xl flex-col gap-14 px-4 py-12">
    <section aria-labelledby="entidade">
      <h2 id="entidade" class="text-2xl font-bold tracking-tight">
        Dados da entidade
      </h2>
      <dl class="mt-4 grid max-w-3xl gap-x-8 gap-y-3 sm:grid-cols-[auto_1fr]">
        <dt class="font-medium">Nome</dt>
        <dd>
          {ORGANIZACAO.nome} ({ORGANIZACAO.sigla})
        </dd>
        <dt class="font-medium">CNPJ</dt>
        <dd>{ORGANIZACAO.cnpj}</dd>
        <dt class="font-medium">Natureza</dt>
        <dd>{ORGANIZACAO.natureza}</dd>
        <dt class="font-medium">Fundação</dt>
        <dd>{ORGANIZACAO.fundacaoPorExtenso}</dd>
        <dt class="font-medium">Sede</dt>
        <dd>
          {ENDERECO_LINHA}, {ORGANIZACAO.cidade} — {ORGANIZACAO.uf}, CEP{' '}
          {ORGANIZACAO.endereco.cep}
        </dd>
        <dt class="font-medium">Contato</dt>
        <dd>
          <a
            href={ORGANIZACAO.telefoneLink}
            class="underline underline-offset-4"
          >
            {ORGANIZACAO.telefone}
          </a>
          ·
          <a
            href={`mailto:${ORGANIZACAO.email}`}
            class="underline underline-offset-4"
          >
            {ORGANIZACAO.email}
          </a>
        </dd>
      </dl>
    </section>

    <section aria-labelledby="recursos">
      <h2 id="recursos" class="text-2xl font-bold tracking-tight">
        Recursos públicos recebidos
      </h2>
      <p class="mt-4 max-w-3xl">
        O que a ASAF recebe de emendas parlamentares e de parcerias com órgãos
        públicos, em que foi gasto e como está a prestação de contas. Os valores
        recebidos e pagos vêm do livro-caixa da associação.
      </p>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        <li
          class="rounded-lg border bg-card p-5 shadow-card"
          data-cartao="emendas"
        >
          <h3 class="text-lg font-semibold">
            <a
              href="/transparencia/emendas/"
              class="text-primary underline underline-offset-4"
            >
              Emendas parlamentares
            </a>
          </h3>
          <p class="mt-2 text-sm">
            {emendas.length === 0
              ? 'A associação ainda não recebeu recursos de emendas parlamentares. Esta página será atualizada em até 24 horas após qualquer recebimento.'
              : `${emendas.length} ${emendas.length === 1 ? 'emenda publicada' : 'emendas publicadas'}, com ${formatarReais(somaRecebido(emendas))} já recebidos.`}
          </p>
        </li>
        <li
          class="rounded-lg border bg-card p-5 shadow-card"
          data-cartao="parcerias"
        >
          <h3 class="text-lg font-semibold">
            <a
              href="/transparencia/parcerias/"
              class="text-primary underline underline-offset-4"
            >
              Parcerias e termos
            </a>
          </h3>
          <p class="mt-2 text-sm">
            {demaisParcerias.length === 0
              ? 'Nenhum termo de fomento, de colaboração ou outra parceria foi publicado até agora.'
              : `${demaisParcerias.length} ${demaisParcerias.length === 1 ? 'parceria publicada' : 'parcerias publicadas'}.`}
          </p>
        </li>
        <li
          class="rounded-lg border bg-card p-5 shadow-card"
          data-cartao="documentos"
        >
          <h3 class="text-lg font-semibold">
            <a
              href="/transparencia/documentos/"
              class="text-primary underline underline-offset-4"
            >
              Documentos
            </a>
          </h3>
          <p class="mt-2 text-sm">
            {documentos.length === 0
              ? 'Atas, certidões, balanços e termos aparecerão aqui quando forem aprovados para publicação.'
              : `${documentos.length} ${documentos.length === 1 ? 'documento publicado' : 'documentos publicados'}, organizados por tipo e ano.`}
          </p>
        </li>
        <li
          class="rounded-lg border bg-card p-5 shadow-card"
          data-cartao="dados"
        >
          <h3 class="text-lg font-semibold">
            <a
              href="/transparencia/dados/"
              class="text-primary underline underline-offset-4"
            >
              Dados abertos
            </a>
          </h3>
          <p class="mt-2 text-sm">
            Os números das emendas e parcerias em planilha (CSV) e em JSON.
          </p>
        </li>
      </ul>
    </section>

    <section aria-labelledby="prestacao">
      <h2 id="prestacao" class="text-2xl font-bold tracking-tight">
        Como a ASAF presta contas
      </h2>
      <p class="mt-4 max-w-3xl">
        O Estatuto determina quem faz o quê na prestação de contas, de modo que
        quem administra o dinheiro responda a quem fiscaliza:
      </p>
      <ol class="mt-6 grid gap-4 md:grid-cols-2">
        {etapasDeContas.map((etapa, indice) => (
          <li class="rounded-lg border bg-card p-5 shadow-card">
            <p class="text-sm font-medium text-primary">
              {indice + 1}. {etapa.artigo}
            </p>
            <h3 class="mt-1 text-lg font-semibold">{etapa.quem}</h3>
            <p class="mt-2 text-sm">{etapa.o_que}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 max-w-3xl font-medium">
        O Estatuto determina que os recursos, o patrimônio e os rendimentos da
        ASAF sejam integralmente aplicados no território brasileiro, no
        desenvolvimento de seus objetivos sociais (Art. 28, § 3º).
      </p>
    </section>

    <section aria-labelledby="documentos">
      <h2 id="documentos" class="text-2xl font-bold tracking-tight">
        Documentos publicados
      </h2>
      <ul class="mt-4 flex flex-col gap-3">
        <li class="rounded-lg border bg-card p-5 shadow-card">
          <a
            href="/estatuto/"
            class="text-lg font-semibold text-primary underline underline-offset-4"
          >
            Estatuto Social
          </a>
          <p class="mt-1 text-sm">
            Texto integral, com 8 capítulos e 35 artigos.
          </p>
        </li>
        {maisRecentes.map((d) => (
          <li class="rounded-lg border bg-card p-5 shadow-card">
            <a
              href={caminhoDoDocumento(d)}
              class="text-lg font-semibold text-primary underline underline-offset-4"
            >
              {d.titulo}{' '}
              <span class="sr-only">
                ({d.formato === 'TEXTO' ? 'texto' : 'PDF'})
              </span>
            </a>
            <p class="mt-1 text-sm">
              {d.tipo}
              {d.data_documento
                ? ` · ${formatarDataCurta(d.data_documento)}`
                : ''}
              {d.aprovado_em
                ? ` · aprovado em ${formatarDataCurta(d.aprovado_em)}`
                : ''}
            </p>
          </li>
        ))}
      </ul>
      <p class="mt-4 max-w-3xl text-sm text-muted-foreground">
        {documentos.length === 0 ? (
          assembleias.length === 0 ? (
            'No momento, o Estatuto é o único documento publicado nesta página. Editais de assembleia e demais documentos aparecerão aqui quando forem publicados.'
          ) : (
            'Atas e prestações de contas aprovadas aparecerão aqui quando forem publicadas.'
          )
        ) : (
          <a
            href="/transparencia/documentos/"
            class="underline underline-offset-4"
          >
            Ver todos os documentos publicados
          </a>
        )}
      </p>
    </section>

    {assembleias.length > 0 && (
      <section aria-labelledby="assembleias">
        <h2 id="assembleias" class="text-2xl font-bold tracking-tight">
          Editais de assembleia
        </h2>
        <p class="mt-4 max-w-3xl">
          Os editais de convocação das assembleias gerais. O texto publicado não
          traz o link de acesso remoto (informado diretamente aos associados) e
          vem com um código (SHA-256) que identifica exatamente o texto
          publicado.
        </p>
        <ul class="mt-6 flex flex-col gap-3">
          {assembleias.map((assembleia) => (
            <li class="rounded-lg border bg-card p-5 shadow-card">
              <p class="text-sm font-medium text-primary">
                {assembleia.status}
              </p>
              <h3 class="mt-1 text-lg font-semibold">
                <a
                  href={caminhoDaAssembleia(assembleia.id_assembleia)}
                  class="underline underline-offset-4"
                >
                  Assembleia Geral {assembleia.tipo}
                </a>
              </h3>
              <p class="mt-1 text-sm">
                1ª convocação: {formatarDia(assembleia.primeira_convocacao)}, às{' '}
                {formatarHora(assembleia.primeira_convocacao)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <FaleConosco titulo="Precisa de alguma informação?">
      <p>
        Se procura um documento que ainda não está aqui, ou quer pedir
        informação sobre os recursos públicos recebidos, fale com a secretaria
        da ASAF.
      </p>
      <p class="mt-3">
        Para pedir informação sobre os recursos públicos recebidos, com número
        de protocolo, use o{' '}
        <a
          href="/transparencia/pedido-de-informacao/"
          class="font-medium text-primary underline underline-offset-4"
        >
          formulário de pedido de informação
        </a>
        .
      </p>
    </FaleConosco>
  </div>
</Base>
