---
import ProximosEventos from '../components/ProximosEventos.astro'
import { ORGANIZACAO, PAINEL_URL } from '../config/organizacao'
import Base from '../layouts/Base.astro'
---

<Base caminho="/">
  <section class="bg-primary text-primary-foreground">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
      <p class="text-sm font-semibold uppercase tracking-wider">
        {ORGANIZACAO.sigla}
      </p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
        {ORGANIZACAO.nome}
      </h1>
      <p class="mt-4 text-xl italic">“{ORGANIZACAO.lema}”</p>
      <p class="mt-6 max-w-2xl text-lg">
        {ORGANIZACAO.natureza}{' '}
        Nosso objetivo principal é {ORGANIZACAO.objetivo}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#eventos"
          class="rounded-md bg-background px-5 py-3 font-medium text-primary hover:bg-secondary"
          >Ver próximos eventos</a
        >
        <a
          href={PAINEL_URL}
          class="rounded-md border border-primary-foreground px-5 py-3 font-medium hover:bg-primary-foreground hover:text-primary"
          >Área do associado</a
        >
      </div>
    </div>
  </section>

  <section
    id="quem-somos"
    aria-labelledby="quem-somos-titulo"
    class="mx-auto max-w-5xl scroll-mt-4 px-4 py-12"
  >
    <h2 id="quem-somos-titulo" class="text-2xl font-bold tracking-tight">
      Quem somos
    </h2>
    <p class="mt-4 max-w-3xl">
      A {ORGANIZACAO.nome} ({ORGANIZACAO.sigla}) foi fundada em {
        ORGANIZACAO.fundacaoPorExtenso
      }, com sede em {ORGANIZACAO.cidade}, {ORGANIZACAO.uf}. Atuamos para
      alcançar as famílias, que são a razão da nossa existência.
    </p>
    <h3 class="mt-8 text-lg font-semibold">Onde atuamos</h3>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        ORGANIZACAO.areasDeAtuacao.map((area) => (
          <li class="rounded-full bg-secondary px-3 py-1 text-sm font-medium text-secondary-foreground">
            {area}
          </li>
        ))
      }
    </ul>
  </section>

  <ProximosEventos />

  <section
    aria-labelledby="associado-titulo"
    class="mx-auto max-w-5xl px-4 pb-16"
  >
    <div class="rounded-lg border bg-card p-6 shadow-card sm:p-8">
      <h2 id="associado-titulo" class="text-xl font-bold tracking-tight">
        Já é associado?
      </h2>
      <p class="mt-2 max-w-2xl">
        Acesse o painel para consultar seus dados, sua carteirinha digital e
        acompanhar as assembleias.
      </p>
      <a
        href={PAINEL_URL}
        class="mt-5 inline-block rounded-md bg-primary px-5 py-3 font-medium text-primary-foreground hover:opacity-90"
        >Entrar na área do associado</a
      >
    </div>
  </section>
</Base>
