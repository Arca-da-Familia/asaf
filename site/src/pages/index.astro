---
import CartaoDeLink from '../components/CartaoDeLink.astro'
import ProximosEventos from '../components/ProximosEventos.astro'
import SeloDeStatus from '../components/SeloDeStatus.astro'
import { LOGO, ORGANIZACAO, PAINEL_URL } from '../config/organizacao'
import Base from '../layouts/Base.astro'
import { caminhoDoProjeto, conteudoPublico } from '../lib/dados-publicos'

// Eventos: a lista é uma ilha (ao vivo); o build só diz quais já têm página para virar link.
// Projetos: até 3 projetos públicos (em execução primeiro) — só aparece a seção se existir algum.
const { eventos, projetos } = await conteudoPublico()
const idsComPagina = eventos.map((e) => e.id_evento)
const emDestaque = [...projetos]
  .sort(
    (a, b) =>
      Number(b.status_codigo === 'EM_EXECUCAO') -
      Number(a.status_codigo === 'EM_EXECUCAO'),
  )
  .slice(0, 3)

// Logo do destaque: 320px de largura; altura pela proporção real (reserva o espaço, sem salto).
const LARGURA_LOGO = 320
const ALTURA_LOGO = Math.round(LARGURA_LOGO / LOGO.proporcao)
---

<Base caminho="/">
  <section class="bg-primary text-primary-foreground">
    <div class="mx-auto grid max-w-5xl items-center gap-10 px-4 py-14 sm:py-20 md:grid-cols-[1fr_auto]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider">
          {ORGANIZACAO.sigla}
        </p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
          {ORGANIZACAO.nome}
        </h1>
        <div class="mt-4 h-1 w-20 rounded bg-brand-secondary"></div>
        <p class="mt-4 text-xl italic">“{ORGANIZACAO.lema}”</p>
        <p class="mt-6 max-w-2xl text-lg">
          {ORGANIZACAO.natureza} Nosso objetivo principal é{' '}
          {ORGANIZACAO.objetivo}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/como-ajudar/"
            class="rounded-md bg-brand-secondary px-5 py-3 font-semibold text-brand-secondary-foreground hover:opacity-90"
          >
            Como ajudar
          </a>
          <a
            href="#eventos"
            class="rounded-md border border-primary-foreground px-5 py-3 font-medium hover:bg-primary-foreground hover:text-primary"
          >
            Ver próximos eventos
          </a>
          <a
            href={PAINEL_URL}
            class="rounded-md border border-primary-foreground px-5 py-3 font-medium hover:bg-primary-foreground hover:text-primary"
          >
            Área do associado
          </a>
        </div>
      </div>
      <img
        src={LOGO.destaque}
        alt={LOGO.alt}
        width={LARGURA_LOGO}
        height={ALTURA_LOGO}
        fetchpriority="high"
        class="mx-auto h-auto w-56 max-w-full md:w-80"
      />
    </div>
  </section>

  <section
    id="quem-somos"
    aria-labelledby="quem-somos-titulo"
    class="mx-auto max-w-5xl scroll-mt-4 px-4 py-12"
  >
    <h2 id="quem-somos-titulo" class="text-2xl font-bold tracking-tight">
      Quem somos
    </h2>
    <p class="mt-4 max-w-3xl">
      A {ORGANIZACAO.nome} ({ORGANIZACAO.sigla}) foi fundada em{' '}
      {ORGANIZACAO.fundacaoPorExtenso}, com sede em {ORGANIZACAO.cidade},{' '}
      {ORGANIZACAO.uf}. Atuamos para alcançar as famílias, que são a razão da
      nossa existência.
    </p>
    <h3 class="mt-8 text-lg font-semibold">Onde atuamos</h3>
    <ul class="mt-3 flex flex-wrap gap-2">
      {ORGANIZACAO.areasDeAtuacao.map((area) => (
        <li class="rounded-full bg-brand-tertiary/25 px-3 py-1 text-sm font-medium text-foreground">
          {area}
        </li>
      ))}
    </ul>
    <p class="mt-6">
      <a
        href="/quem-somos/"
        class="font-medium text-primary underline underline-offset-4"
      >
        Conheça a ASAF →
      </a>
    </p>
  </section>

  <ProximosEventos idsComPagina={idsComPagina} />

  {emDestaque.length > 0 && (
    <section
      aria-labelledby="projetos-titulo"
      class="mx-auto max-w-5xl px-4 pb-12"
    >
      <h2 id="projetos-titulo" class="text-2xl font-bold tracking-tight">
        Nossos projetos
      </h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {emDestaque.map((projeto) => (
          <li class="flex flex-col rounded-lg border bg-card p-5 shadow-card">
            <p>
              <SeloDeStatus
                codigo={projeto.status_codigo}
                rotulo={projeto.status}
              />
            </p>
            <h3 class="mt-3 text-lg font-semibold">
              <a
                href={caminhoDoProjeto(projeto.id_projeto)}
                class="underline-offset-4 hover:underline"
              >
                {projeto.nome}
              </a>
            </h3>
            {projeto.descricao && (
              <p class="mt-2 line-clamp-3 text-sm">{projeto.descricao}</p>
            )}
          </li>
        ))}
      </ul>
      <p class="mt-6">
        <a
          href="/projetos/"
          class="font-medium text-primary underline underline-offset-4"
        >
          Ver todos os projetos →
        </a>
      </p>
    </section>
  )}

  <section
    aria-labelledby="participe-titulo"
    class="mx-auto max-w-5xl px-4 py-12"
  >
    <h2 id="participe-titulo" class="text-2xl font-bold tracking-tight">
      Participe
    </h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <CartaoDeLink
        titulo="Seja associado"
        href="/seja-associado/"
        rotulo="Veja como se associar"
      >
        <p>Faça parte da associação e participe das decisões da assembleia.</p>
      </CartaoDeLink>
      <CartaoDeLink
        titulo="Seja voluntário"
        href="/seja-voluntario/"
        rotulo="Veja como ser voluntário"
      >
        <p>Dedique um pouco do seu tempo às famílias atendidas pela ASAF.</p>
      </CartaoDeLink>
      <CartaoDeLink
        titulo="Apoie a ASAF"
        href="/como-ajudar/"
        rotulo="Veja como ajudar"
      >
        <p>Doações, patrocínios e parcerias ajudam a manter os projetos.</p>
      </CartaoDeLink>
    </div>
  </section>

  <section
    aria-labelledby="transparencia-titulo"
    class="mx-auto max-w-5xl px-4 pb-12"
  >
    <div class="rounded-lg border bg-card p-6 shadow-card sm:p-8">
      <h2 id="transparencia-titulo" class="text-xl font-bold tracking-tight">
        Contas claras
      </h2>
      <p class="mt-2 max-w-2xl">
        O Estatuto exige que a Diretoria preste contas à Assembleia Geral e que
        o Conselho Fiscal examine toda a movimentação financeira. Veja como isso
        funciona e leia o Estatuto na íntegra.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href="/transparencia/"
          class="inline-block rounded-md bg-primary px-5 py-3 font-medium text-primary-foreground hover:opacity-90"
        >
          Transparência
        </a>
        <a
          href="/estatuto/"
          class="inline-block rounded-md border px-5 py-3 font-medium hover:bg-accent"
        >
          Estatuto Social
        </a>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="associado-titulo"
    class="mx-auto max-w-5xl px-4 pb-16"
  >
    <div class="rounded-lg border bg-card p-6 shadow-card sm:p-8">
      <h2 id="associado-titulo" class="text-xl font-bold tracking-tight">
        Já é associado?
      </h2>
      <p class="mt-2 max-w-2xl">
        Acesse o painel para consultar seus dados, sua carteirinha digital e
        acompanhar as assembleias.
      </p>
      <a
        href={PAINEL_URL}
        class="mt-5 inline-block rounded-md bg-primary px-5 py-3 font-medium text-primary-foreground hover:opacity-90"
      >
        Entrar na área do associado
      </a>
    </div>
  </section>
</Base>
