---
import FormularioDeAtendimento from '../../../components/FormularioDeAtendimento.astro'
import TituloDePagina from '../../../components/TituloDePagina.astro'
import type { Migalha } from '../../../config/navegacao'
import Base from '../../../layouts/Base.astro'
import { DIREITOS_DO_TITULAR } from '../../../lib/atendimento-pedido'

// O formulário manda a solicitação para a fila única de atendimento do sistema (tipo TITULAR_LGPD). A lista abaixo é a MESMA do campo "O que você quer pedir":
// um lugar só (`lib/atendimento-pedido.ts`), para a página e o formulário nunca divergirem. Nada aqui promete resultado nem cita lei: quem explica o
// tratamento dos dados é a Política de Privacidade.
const migalhas: Migalha[] = [
  { rotulo: 'Política de Privacidade', href: '/privacidade/' },
  { rotulo: 'Solicitação do titular de dados' },
]
---

<Base
  titulo="Solicitação do titular de dados"
  descricao="Peça à ASAF, pelo formulário, o que você quer saber ou mudar sobre os seus dados pessoais: confirmação, acesso, correção, eliminação e outros pedidos."
  caminho="/privacidade/solicitacao-do-titular/"
  migalhas={migalhas}
>
  <TituloDePagina
    titulo="Solicitação do titular de dados"
    resumo="Titular dos dados é a pessoa a quem os dados se referem. Aqui você pode fazer um pedido sobre os seus dados pessoais."
    migalhas={migalhas}
  />

  <div class="mx-auto flex max-w-5xl flex-col gap-10 px-4 py-12">
    <section aria-labelledby="o-que-pedir">
      <h2 id="o-que-pedir" class="text-2xl font-bold tracking-tight">
        O que você pode pedir
      </h2>
      <p class="mt-4 max-w-3xl">
        Se a ASAF guarda dados seus, você pode pedir à associação, por exemplo:
      </p>
      <ul class="mt-4 flex max-w-3xl list-disc flex-col gap-2 pl-6">
        {DIREITOS_DO_TITULAR.map((direito) => (
          <li>{direito.rotulo}</li>
        ))}
      </ul>
      <p class="mt-4 max-w-3xl">
        Para saber como a associação trata os dados pessoais, leia a{' '}
        <a
          href="/privacidade/"
          class="font-medium text-primary underline underline-offset-4"
        >
          Política de Privacidade
        </a>
        .
      </p>
    </section>

    <section aria-labelledby="como-a-resposta-chega" data-como-a-resposta-chega>
      <h2 id="como-a-resposta-chega" class="text-2xl font-bold tracking-tight">
        Como a resposta chega até você
      </h2>
      <p class="mt-4 max-w-3xl">
        Dado pessoal só pode ir para quem prova ser a pessoa a quem ele se
        refere; se não fosse assim, qualquer um que soubesse o seu CPF poderia
        pedir os seus dados. Por isso o caminho tem três passos:
      </p>
      <ol class="mt-4 flex max-w-3xl list-decimal flex-col gap-2 pl-6">
        <li>
          Você envia o pedido com o seu CPF e o seu e-mail (o e-mail é
          obrigatório).
        </li>
        <li>
          A associação confere que quem pediu é o titular. Se o e-mail é o do
          seu cadastro de associado, o sistema confere sozinho; nos outros
          casos, a equipe confere por outro meio (por exemplo, um documento com
          foto) e registra o que conferiu. Sem essa conferência, a associação
          não responde com dado pessoal; se não conseguir conferir, encerra o
          pedido, e o motivo aparece na área Minha conta.
        </li>
        <li>
          Quando há resposta, tentamos avisar pelo e-mail que você informou. A
          resposta não vai nesse e-mail: você entra na área{' '}
          <a
            href="/minha-conta/"
            class="font-medium text-primary underline underline-offset-4"
          >
            Minha conta
          </a>{' '}
          com o mesmo e-mail e digita o código de 6 números que o site envia.
        </li>
      </ol>
    </section>

    <FormularioDeAtendimento
      tipo="TITULAR_LGPD"
      titulo="Faça a sua solicitação"
      idDoFormulario="solicitacao-do-titular"
      instrucao="Escolha o que você quer pedir, conte o que precisa e informe o seu CPF e o seu e-mail."
    />

    <p class="text-sm">
      <a
        href="/privacidade/"
        class="font-medium text-primary underline underline-offset-4"
      >
        Voltar para a Política de Privacidade
      </a>
    </p>
  </div>
</Base>
