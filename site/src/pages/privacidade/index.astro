---
import TituloDePagina from '../../components/TituloDePagina.astro'
import type { Migalha } from '../../config/navegacao'
import {
  DOCUMENTOS_LEGAIS,
  ENDERECO_LINHA,
  PAINEL_URL,
} from '../../config/organizacao'
import { conteudoPublico, organizacaoDoSite } from '../../lib/dados-publicos'
import { presidenteDaDiretoria } from '../../lib/diretoria'
import Base from '../../layouts/Base.astro'

// os dados da associação como o site os mostra: os fixos, com o que a Instituição do painel marcou "vai para o site" por cima (v5.4h)
const ORGANIZACAO = await organizacaoDoSite()
// o encarregado pelo tratamento de dados é o Presidente (LGPD, art. 41): o nome vem do mandato vigente que o sistema publica
const presidente = presidenteDaDiretoria((await conteudoPublico()).diretoria)

// Texto escrito SÓ com o que o site e o sistema realmente fazem hoje. Versionado em
// config/organizacao.ts (v1.1: corrigido pela verificação de fatos de 2026-10-03, que apontou
// promessas sem lastro — eliminação automática por prazo, base legal por formulário, consentimento
// de menor imposto pelo sistema — tudo isso ainda é a FASE 7 e por isso NÃO está prometido aqui).
// Revisão jurídica: a associação não contrata advogado e o Presidente deu o texto por válido (2026-10-09).
// Encarregado pelo tratamento de dados (LGPD, art. 41): o Presidente, por decisão dele (2026-10-09); v1.4.
// v1.7 (2026-10-13): evento cancelado, adiado ou remarcado => o sistema avisa por e-mail quem está inscrito (inclusive na lista de espera) — app/services/status_do_evento.py.
// v1.8 (2026-10-15): o parágrafo da inscrição em evento passou pela conferência independente de fatos e foi corrigido (o formulário nem sempre existe; o e-mail é tentativa; sem código na
// lista de espera; contato do cadastro; IP na Auditoria e ao abrir/cancelar/confirmar; a inscrição não é cancelada pelo sistema) e o encarregado só é nomeado quando o mandato está publicado.
// v1.9 (2026-10-16): a página Diretoria passa a mostrar a foto de quem autorizou o uso da imagem (decisão do Presidente, 2026-10-15) — app/services/fotos_da_diretoria.py: sem a autorização a foto não é
// guardada; só é pública com mandato vigente (a API confere a cada pedido; a cópia do site sai na publicação seguinte); apagar (pedido de quem retirou a autorização, registrado por quem tem a permissão
// `governanca`) tira do sistema na hora e do site na publicação seguinte, mas o armazenamento privado mantém cópias de segurança internas (versionamento do Azure) e o Postgres tem backup de 35 dias:
// por isso o texto diz "ficam apenas cópias de segurança internas", nunca "apagada de todo lugar". A foto do cadastro de associado (a da carteirinha) não vai a NENHUMA página do site, mas a verificação
// pública da carteirinha (QR, GET /carteirinha/verificar/{token}) a devolve, com nome, situação e validade: o texto diz isso. (Conferência independente de fatos, 2026-10-15, corrigiu duas frases que
// prometiam demais: "apagada na hora" como se fosse de todo lugar e "nunca em outra página" calando a verificação da carteirinha.)
// v1.10 (2026-10-16): decisões do Presidente depois da v1.9 — "tem que apagar, não pode ficar guardado": a foto da Diretoria é apagada SOZINHA quando o mandato termina (no ato de encerrar o mandato e, no
// vencimento natural, pela rotina `scripts/apagar_fotos_da_diretoria_vencidas.py`, que roda com as demais tarefas periódicas do GitHub, algumas vezes ao dia; 24 horas de prazo só para quem NUNCA teve mandato
// cadastrado); o armazenamento privado do Azure apaga as versões antigas das fotos (regra de ciclo de vida: 1 dia depois de gravadas; mais o soft delete de 25 dias = cerca de 30 dias; o banco guarda só o
// nome do arquivo e a descrição, em backup de 35 dias); o QR da carteirinha deixa de valer 365 dias: vale `DIAS_VALIDADE_CARTEIRINHA` (padrão 15, teto 20) a partir da emissão, também para os QR já
// emitidos, e a verificação pública entrega a foto por uma rota que confere o QR a cada pedido (`app/routers/associados.py`), nunca o endereço aberto `/uploads/...`. A conferência independente de fatos
// (2026-10-15) corrigiu: o tempo da publicação do site (o GitHub atrasa o agendamento: são horas, não "15 a 30 minutos"), a regra das 24 horas e o teto da validade do QR.
// v2.0 (2026-10-16): doação pelo site com Pix estático (v5.6a) — a página /como-ajudar/doar/ passa a coletar nome, e-mail e CPF (opcional) de quem doa identificando-se: o parágrafo `data-doacao` diz SÓ o que o
// servidor faz (app/services/doacao_online.py, app/routers/doacao_online.py, app/services/protecao_publica.py): a doação sem se identificar não grava dado pessoal nenhum (só devolve o código Pix); a identificada grava
// nome, e-mail, CPF se informado, valor, campanha, a versão do aviso e o momento do aceite, uma impressão (SHA-256) do pedido que só reconhece o mesmo pedido enviado duas vezes, e o IP (no limite de pedidos por hora e na
// Auditoria); a tesouraria é avisada no painel e só a confirmação dela cria a doação e o recibo numerado; o pedido que ninguém confirma fica "prazo vencido" mas NÃO é apagado (a rotina de eliminação não existe: nenhum prazo é
// prometido aqui). A base legal vai no texto como consentimento e escrituração contábil (sem prazo de guarda).
const migalhas: Migalha[] = [{ rotulo: 'Política de Privacidade' }]
const { versao, vigenteDesde } = DOCUMENTOS_LEGAIS.privacidade
const dataExtenso = new Intl.DateTimeFormat('pt-BR', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(new Date(`${vigenteDesde}T00:00:00Z`))

const direitos = [
  'confirmar se tratamos dados seus;',
  'acessar os seus dados;',
  'corrigir dados incompletos, inexatos ou desatualizados;',
  'pedir a anonimização, o bloqueio ou a eliminação de dados desnecessários, excessivos ou tratados em desacordo com a lei;',
  'pedir a portabilidade dos dados;',
  'pedir a eliminação dos dados tratados com o seu consentimento;',
  'saber com quem compartilhamos os seus dados;',
  'ser informado sobre a possibilidade de não consentir e sobre as consequências disso;',
  'revogar o consentimento a qualquer momento.',
]
---

<Base
  titulo="Política de Privacidade"
  descricao="Como a ASAF trata dados pessoais: o que este site coleta (quase nada), com quem compartilhamos, por quanto tempo guardamos e como exercer os seus direitos."
  caminho="/privacidade/"
  migalhas={migalhas}
>
  <TituloDePagina
    titulo="Política de Privacidade"
    resumo={`Versão ${versao} · em vigor desde ${dataExtenso}`}
    migalhas={migalhas}
  />

  <div class="mx-auto flex max-w-3xl flex-col gap-10 px-4 py-12 leading-relaxed">
    <section
      aria-labelledby="resumo"
      class="rounded-lg border bg-card p-6 shadow-card"
    >
      <h2 id="resumo" class="text-xl font-bold tracking-tight">
        Em resumo
      </h2>
      <ul class="mt-3 flex list-disc flex-col gap-2 pl-6">
        <li>
          Este site <strong>não instala cookies</strong>, não tem anúncios e não
          usa ferramentas de análise de visitantes de terceiros.
        </li>
        <li>
          Enquanto você apenas navega, o site
          <strong>não coleta dados pessoais</strong>
          informados por você. Os dados pessoais que a ASAF trata ficam no seu
          sistema de gestão. O que o site publica é o que a diretoria aprova: a
          lista de dirigentes, documentos e dados de emendas e parcerias
          (conferidos para não trazer CPF, RG, e-mail ou celular de pessoas) e
          fotos de atividades e de dirigentes, só com autorização de imagem.
        </li>
        <li>
          Não vendemos dados. Você pode exercer os seus direitos pelo{' '}
          <a
            href="/privacidade/solicitacao-do-titular/"
            class="font-medium text-primary underline underline-offset-4"
          >
            formulário de solicitação do titular de dados
          </a>{' '}
          ou escrevendo para{' '}
          <a
            href={`mailto:${ORGANIZACAO.email}`}
            class="font-medium text-primary underline underline-offset-4"
          >
            {ORGANIZACAO.email}
          </a>
          .
        </li>
      </ul>
    </section>

    <section aria-labelledby="quem">
      <h2 id="quem" class="text-xl font-bold tracking-tight">
        Quem é a responsável pelos dados
      </h2>
      <p class="mt-3">
        A responsável (controladora) é a {ORGANIZACAO.nome} ({ORGANIZACAO.sigla}
        ), CNPJ {ORGANIZACAO.cnpj}, com sede na {ENDERECO_LINHA},
        {ORGANIZACAO.cidade} — {ORGANIZACAO.uf}, CEP {ORGANIZACAO.endereco.cep}.
        O canal para falar sobre dados pessoais é o e-mail{' '}
        <a
          href={`mailto:${ORGANIZACAO.email}`}
          class="font-medium text-primary underline underline-offset-4"
        >
          {ORGANIZACAO.email}
        </a>
        .
      </p>
      <p class="mt-3" data-encarregado>
        <strong>Encarregado pelo tratamento de dados pessoais</strong> (Lei nº
        13.709/2018, art. 41): o Presidente da ASAF
        {presidente ? (
          <>
            , <strong>{presidente}</strong>
          </>
        ) : (
          <>
            {' '}
            (a página{' '}
            <a
              href="/diretoria/"
              class="font-medium text-primary underline underline-offset-4"
            >
              Diretoria
            </a>{' '}
            mostra o nome quando o mandato vigente está cadastrado no sistema)
          </>
        )}
        . O contato é o mesmo e-mail acima ou o{' '}
        <a
          href="/privacidade/solicitacao-do-titular/"
          class="font-medium text-primary underline underline-offset-4"
        >
          formulário de solicitação do titular de dados
        </a>
        .
      </p>
    </section>

    <section aria-labelledby="site">
      <h2 id="site" class="text-xl font-bold tracking-tight">
        O que este site faz quando você apenas navega
      </h2>
      <ul class="mt-3 flex list-disc flex-col gap-3 pl-6">
        <li>
          <strong>Dados técnicos de acesso.</strong> Como em qualquer site, a
          plataforma de hospedagem (Microsoft Azure) pode registrar dados
          técnicos de cada acesso, como endereço IP, data e hora, para a
          segurança e o funcionamento do serviço. A ASAF não usa esses dados
          para traçar o perfil de visitantes.
        </li>
        <li>
          <strong>Lista de eventos.</strong> Para mostrar os eventos, o
          navegador consulta a lista pública de eventos da ASAF (no endereço
          api.asaf.org.br). Como em qualquer acesso à internet, o seu endereço
          IP chega ao servidor, mas nenhum dado pessoal informado por você é
          enviado.
        </li>
        <li>
          <strong>Campanhas e Pix da doação.</strong> A página Doar consulta o
          sistema da ASAF (no endereço api.asaf.org.br) para mostrar as
          campanhas em andamento e o Pix da associação. Como em qualquer acesso,
          o seu endereço IP chega ao servidor; o valor e a campanha que você
          escolhe para gerar o código Pix vão na consulta, mas nenhum dado
          pessoal informado por você é enviado.
        </li>
        <li>
          <strong>Cookies e dados no navegador.</strong> Este site não instala
          cookies nem guarda dados no seu navegador. A{' '}
          <a
            href={PAINEL_URL}
            class="font-medium text-primary underline underline-offset-4"
          >
            área do associado
          </a>{' '}
          (um endereço separado, para quem já é associado) usa um cookie
          técnico, estritamente necessário, para manter a sua sessão aberta, e
          guarda no navegador a sua preferência de tema (claro ou escuro). Nada
          disso é usado para rastrear você.
        </li>
        <li>
          <strong>Diretoria e Conselho Fiscal.</strong> A página de Diretoria e
          Conselho Fiscal publica o nome, o cargo e as datas do mandato de quem
          ocupa cargos na ASAF, em respeito ao princípio da publicidade adotado
          pelo Estatuto (Art. 2º), e a foto de quem autorizou o uso da imagem
          (veja abaixo). Não publicamos CPF, telefone nem e-mail.
        </li>
        <li>
          <strong>Links para outros sites.</strong> Ao clicar em um link para um
          site de terceiros (por exemplo, o mapa do Google na página de
          contato), você passa a ser regido pela política desse site.
        </li>
      </ul>
      <p class="mt-3" data-diretoria-foto>
        <strong>Foto de quem está na Diretoria ou no Conselho Fiscal.</strong> A
        página{' '}
        <a
          href="/diretoria/"
          class="font-medium text-primary underline underline-offset-4"
        >
          Diretoria
        </a>{' '}
        mostra o nome, o cargo, o período do mandato e, de quem autorizou o uso
        da imagem, a foto. Sem a autorização a foto não é guardada no sistema. A
        foto só existe enquanto a pessoa tem mandato vigente ou marcado: quando
        o mandato termina e a pessoa não tem outro, o sistema apaga a foto
        sozinho (na hora, se o mandato for encerrado no sistema; no vencimento
        natural, na conferência automática que roda algumas vezes ao dia), e
        quem recebeu a foto antes de ter o primeiro mandato cadastrado tem até
        24 horas para ele aparecer. Quem retira a autorização pode pedir à
        Diretoria que apague a foto: ao registrar o pedido no sistema, ela é
        apagada na hora. Apagada a foto, ela deixa de aparecer no site na
        publicação seguinte: o site confere o sistema algumas vezes ao dia,
        então isso costuma levar algumas horas e pode passar de meio dia. Do
        arquivo da foto ficam apenas cópias de segurança internas, que não são
        públicas, por até cerca de 30 dias; as cópias de segurança do banco de
        dados (que guardam o nome do arquivo e a descrição da foto, não a
        imagem) duram até 35 dias. Depois de apagada, se a pessoa voltar a ter
        mandato, é preciso enviar a foto de novo. A foto do cadastro de
        associado (a da carteirinha) não é usada em nenhuma página deste site;
        para o público ela só aparece na verificação da carteirinha digital,
        para quem lê o QR da carteirinha (sem precisar de login), junto com o
        nome, a situação de associado e a validade, e só enquanto o QR vale.
        Esse QR vale por poucos dias a partir de quando é gerado (hoje, 15 dias;
        no máximo 20): depois disso a verificação não mostra mais nada, nem a
        foto.
      </p>
    </section>

    <section aria-labelledby="formularios">
      <h2 id="formularios" class="text-xl font-bold tracking-tight">
        Cadastros e formulários
      </h2>
      <p class="mt-3">
        Este site tem sete formulários que pedem dados pessoais: o pedido de
        filiação, quatro formulários de atendimento (contato, pedido de
        informação sobre recursos públicos, solicitação do titular de dados e
        voluntariado), a inscrição em eventos e a doação em que você se
        identifica (a doação sem se identificar não pede dado nenhum). O pedido
        de filiação fica na página{' '}
        <a
          href="/seja-associado/"
          class="font-medium text-primary underline underline-offset-4"
        >
          Seja associado
        </a>
        . Ele pede nome completo, CPF, data de nascimento e e-mail ou telefone
        e, de quem tem 16 ou 17 anos, a declaração de que os pais ou
        responsáveis autorizaram. Antes do envio, a própria página mostra o
        aviso de privacidade e só envia o pedido depois que você o aceita; a
        versão do aviso e o momento do aceite ficam registrados no pedido. Os
        dados vão para o sistema de gestão da ASAF, onde a Diretoria Executiva
        analisa o pedido. Para que três sócios possam propor o seu nome, o
        painel mostra o seu nome e a sua idade a todos os sócios ativos e em
        dia; CPF, e-mail e telefone só a Diretoria vê, e os motivos de uma
        eventual recusa, escritos por sócios, ficam visíveis à Diretoria. O
        endereço IP de quem envia também fica registrado, por segurança. Pedidos
        recusados ou sem andamento ficam guardados no sistema; para pedir a
        eliminação, escreva para o e-mail acima e o pedido será analisado.
      </p>
      <p class="mt-3" data-formularios-de-atendimento>
        <strong>Formulários de atendimento.</strong> O de contato e o de pedido
        de informação sobre recursos públicos pedem nome, e-mail ou telefone,
        assunto e a sua mensagem; o de solicitação do titular de dados pede
        nome, e-mail ou telefone, o CPF (só para conferir que quem pede é o
        titular), o direito que você quer exercer e a sua mensagem; o de
        voluntariado pede nome, e-mail ou telefone, a data de nascimento (para
        sabermos se é preciso a autorização de um responsável, no caso de quem
        tem menos de 18 anos), o CPF, se você quiser informar, e a sua mensagem.
        Antes do envio, a página mostra o aviso de privacidade e só envia o
        pedido depois que você o aceita; a versão do aviso e o momento do aceite
        ficam registrados no pedido. Cada pedido recebe um número de protocolo e
        um prazo de resposta, mostrados na hora na própria página. Os dados vão
        para o sistema de gestão da ASAF, onde só vê o pedido quem atende na
        associação (hoje, a Presidência e a Diretoria). Guardamos o pedido, o
        protocolo e a nossa resposta para provar que atendemos no prazo. Se você
        informar e-mail, mandamos um e-mail confirmando o recebimento (com o
        protocolo e o prazo), e a resposta também pode seguir por ele. Quando a
        secretaria cadastra você como voluntário, o seu nome, o seu contato, a
        data de nascimento e o CPF (se informado) passam a constar do cadastro
        da ASAF e do termo de adesão de voluntário. O endereço IP de quem envia
        também fica registrado, por segurança. Para pedir que apaguemos o que
        guardamos, use a solicitação do titular de dados.
      </p>
      <p class="mt-3" data-inscricao-em-evento>
        <strong>Inscrição em eventos.</strong> A página de um evento gratuito
        que ainda vai acontecer pode ter um formulário de inscrição (se o evento
        pede o envio de um arquivo, está cancelado ou adiado, ou já passou, a
        página não oferece o formulário). Ele pede nome, CPF, e-mail, telefone,
        as respostas às perguntas daquele evento e, se você inscrever mais
        pessoas, o nome, o CPF e as respostas de cada uma; o e-mail e o telefone
        que você informa valem como contato de todas as pessoas da mesma
        inscrição. Antes do envio, a página mostra o texto de consentimento e só
        envia depois que você o aceita; a versão do texto fica registrada na
        inscrição. Os dados vão para o sistema de gestão da ASAF, onde só vê
        quem organiza os eventos (hoje, a Presidência e a Diretoria); o registro
        técnico da inscrição, com o endereço IP, também aparece na Auditoria do
        sistema, que o Conselho Fiscal consulta. Depois de enviar, a página
        mostra o link da sua inscrição (para cancelar e, se você for chamado da
        lista de espera, para confirmar a vaga) e, havendo vaga, o código de
        check-in; o sistema também tenta enviar o mesmo por e-mail, mas esse
        envio pode falhar: guarde o link da página. Quem se inscreve só para um
        evento passa a constar do cadastro da ASAF como participante externo, e
        isso não faz da pessoa uma associada; se você já tinha cadastro, o
        contato que já estava nele é mantido, e é para esse contato que vão os
        avisos seguintes, como o de uma vaga que abriu na lista de espera.
        Quando a ASAF muda a situação do evento (cancela, adia, remarca ou volta
        a programá-lo), o sistema tenta avisar por e-mail, no contato do
        cadastro, quem está inscrito ou na lista de espera; a inscrição em si
        não é cancelada pelo sistema. O endereço IP de quem envia, abre, cancela
        ou confirma uma inscrição pelo link também fica registrado, por
        segurança.
      </p>
      <p class="mt-3" id="doacao-pelo-site" data-doacao>
        <strong>Doação pelo site.</strong> A página{' '}
        <a
          href="/como-ajudar/doar/"
          class="font-medium text-primary underline underline-offset-4"
        >
          Doar
        </a>{' '}
        tem duas formas de doar pelo Pix. <em>Sem se identificar:</em> o site só
        mostra o código Pix e o QR Code (desenhado no seu navegador) e não grava
        nenhum dado pessoal seu no sistema da ASAF; o pagamento é feito no
        aplicativo do seu banco e, como em qualquer Pix, o extrato do banco da
        associação mostra quem pagou. <em>Identificando-se:</em> o formulário
        pede nome completo, e-mail e, se você quiser, CPF, valor e campanha. O
        sistema guarda esses dados, o seu aceite do aviso de privacidade (a
        versão do aviso e o momento do aceite) e um código calculado a partir do
        pedido, que serve só para reconhecer o mesmo pedido enviado duas vezes;
        o endereço IP de quem envia fica registrado, por segurança, no controle
        do limite de pedidos por hora e na Auditoria do sistema. Usamos esses
        dados para conferir o seu Pix no extrato do banco da associação,
        registrar a doação e emitir o recibo, que o sistema tenta enviar por
        e-mail (o sistema também tenta mandar, quando você envia o pedido, o
        protocolo e o código Pix). O sistema avisa quem cuida da tesouraria
        (quem tem a permissão do financeiro), que vê o pedido no painel. O que
        nos autoriza a tratar esses dados é o seu consentimento (o aceite do
        aviso) e, depois que a tesouraria confirma a doação, a escrituração
        contábil e financeira dela, em que o recibo é numerado; se o CPF for de
        quem já é associado, a doação fica ligada ao cadastro dessa pessoa. O
        pedido que ainda espera conferência passa a ser marcado como “prazo
        vencido” depois dos dias informados na página (o padrão é 15), por uma
        rotina que roda algumas vezes ao dia, e continua guardado no sistema:
        hoje o sistema não apaga esses pedidos sozinho e não há prazo definido
        para apagá-los. Para pedir que sejam apagados, use a{' '}
        <a
          href="/privacidade/solicitacao-do-titular/"
          class="font-medium text-primary underline underline-offset-4"
        >
          solicitação do titular de dados
        </a>
        ; o pedido será analisado conforme a lei e as obrigações da ASAF (a
        doação já confirmada faz parte da escrituração contábil). Esses dados
        não vão para ninguém além dos prestadores de infraestrutura e das
        autoridades citados em “Com quem compartilhamos”; o pagamento em si
        passa pelo banco que você mesmo escolhe.
      </p>
      <p class="mt-3">
        Cada formulário informa, antes do envio, quais dados pede e para quê.
      </p>
      <p class="mt-3">
        Fora do site, a ASAF trata, no seu sistema de gestão, dados de
        associados, voluntários, participantes de eventos e beneficiários — em
        geral informados por essas pessoas à secretaria — para cumprir o
        Estatuto e a lei (como o livro de associados e a escrituração contábil)
        e para realizar as suas atividades.
      </p>
      <p class="mt-3">
        Sobre menores: quem tem 16 ou 17 anos só se filia com a autorização dos
        pais ou responsáveis (Estatuto, Art. 12). Pais e responsáveis podem
        pedir informações e correções sobre os dados de um menor pelo e-mail
        acima.
      </p>
    </section>

    <section aria-labelledby="compartilhamento">
      <h2 id="compartilhamento" class="text-xl font-bold tracking-tight">
        Com quem compartilhamos
      </h2>
      <p class="mt-3">
        A ASAF não vende nem aluga dados pessoais. Os dados podem ser tratados
        por prestadores de infraestrutura que trabalham por conta da ASAF
        (hospedagem, banco de dados e envio de e-mail) e fornecidos a
        autoridades quando houver exigência legal.
      </p>
    </section>

    <section aria-labelledby="guarda">
      <h2 id="guarda" class="text-xl font-bold tracking-tight">
        Por quanto tempo guardamos
      </h2>
      <p class="mt-3">
        Pelo tempo necessário para cumprir a finalidade do tratamento e as
        obrigações legais e estatutárias da ASAF. Você pode pedir a eliminação
        ou a anonimização de dados desnecessários, ou tratados com o seu
        consentimento (veja os seus direitos abaixo); cada pedido é analisado
        conforme a lei e as obrigações da associação.
      </p>
    </section>

    <section aria-labelledby="seguranca">
      <h2 id="seguranca" class="text-xl font-bold tracking-tight">
        Segurança
      </h2>
      <p class="mt-3">
        A comunicação com este site e com a área do associado é criptografada
        (HTTPS). Os dados de associados ficam em ambiente de acesso restrito,
        liberado por perfil conforme a função de cada pessoa, com registro dos
        logins e das alterações.
      </p>
    </section>

    <section aria-labelledby="direitos">
      <h2 id="direitos" class="text-xl font-bold tracking-tight">
        Os seus direitos
      </h2>
      <p class="mt-3">
        A Lei Geral de Proteção de Dados (Lei nº 13.709/2018, art. 18) garante
        que você pode, a qualquer momento:
      </p>
      <ul class="mt-3 flex list-disc flex-col gap-1 pl-6">
        {direitos.map((direito) => (
          <li>{direito}</li>
        ))}
      </ul>
      <p class="mt-3">
        Para exercer qualquer desses direitos, use o{' '}
        <a
          href="/privacidade/solicitacao-do-titular/"
          class="font-medium text-primary underline underline-offset-4"
        >
          formulário de solicitação do titular de dados
        </a>{' '}
        ou escreva para{' '}
        <a
          href={`mailto:${ORGANIZACAO.email}`}
          class="font-medium text-primary underline underline-offset-4"
        >
          {ORGANIZACAO.email}
        </a>
        . A lei prevê que a resposta completa a um pedido de acesso seja dada em
        até 15 dias (art. 19, II). Se achar que o seu pedido não foi atendido,
        você também pode reclamar à Autoridade Nacional de Proteção de Dados
        (ANPD).
      </p>
    </section>

    <section aria-labelledby="mudancas">
      <h2 id="mudancas" class="text-xl font-bold tracking-tight">
        Mudanças nesta política
      </h2>
      <p class="mt-3">
        Quando este texto mudar, a versão e a data de vigência no topo da página
        são atualizadas. Esta é a versão {versao}, em vigor desde {dataExtenso}.
      </p>
    </section>
  </div>
