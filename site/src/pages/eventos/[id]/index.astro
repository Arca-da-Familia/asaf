---
import EdicoesEEventos from '../../../components/contexto/EdicoesEEventos.astro'
import GaleriaDeFotos from '../../../components/contexto/GaleriaDeFotos.astro'
import NoticiasRelacionadas from '../../../components/contexto/NoticiasRelacionadas.astro'
import RelatoriosEDocumentos from '../../../components/contexto/RelatoriosEDocumentos.astro'
import FaleConosco from '../../../components/FaleConosco.astro'
import FormularioDeInscricao from '../../../components/FormularioDeInscricao.astro'
import TituloDePagina from '../../../components/TituloDePagina.astro'
import type { Migalha } from '../../../config/navegacao'
import {
  API_URL,
  ENDERECO_LINHA,
  ORGANIZACAO,
  SITE_URL,
} from '../../../config/organizacao'
import Base from '../../../layouts/Base.astro'
import {
  noticiasDoEvento,
  soComPagina,
  soDocumentosPublicados,
} from '../../../lib/contexto'
import {
  caminhoDoEvento,
  caminhoDoProjeto,
  conteudoPublico,
  type EventoDetalhado,
  type NoticiaPublica,
} from '../../../lib/dados-publicos'
import {
  comFusoDaAsaf,
  formatarDia,
  formatarHora,
  jaAconteceu,
  quandoEmPartes,
} from '../../../lib/datas'
import { pedeArquivo } from '../../../lib/inscricao-evento'
import { jsonLdEvento } from '../../../lib/seo'
import {
  avisoDaSituacao,
  CLASSES_DO_AVISO,
  fraseDeInscricaoParada,
  inscricoesParadas,
  situacaoDoEvento,
} from '../../../lib/situacao-do-evento'
import { descricaoParaMeta, tituloCurto } from '../../../lib/texto'

// Uma página por evento público, com URL estável e compartilhável (/eventos/<id>/): título, data e
// local certos no WhatsApp/Google (schema.org/Event). O que muda depois do build (vagas, evento
// retirado, "já aconteceu") é resolvido pela ilha src/lib/evento-vivo.ts.
//
// v5.5: o contexto do evento — projeto a que pertence, outras edições, relatório, fotos e notícias ligadas pelo
// número. Cada bloco SÓ existe quando há conteúdo.
//
// v5.5c: a inscrição. Evento GRATUITO que ainda não aconteceu e sem pergunta de arquivo tem o formulário (a ilha dele fica em
// src/lib/inscricao-evento.ts); evento com valor, ou que pede um arquivo, manda falar com a secretaria. Um evento que já aconteceu
// (no build, ou quando a ilha `evento-vivo` descobre no navegador) não oferece inscrição.
//
// v5.5d: a situação do evento (cancelado, adiado, remarcado, realizado). O aviso vai NO TOPO, escrito (nunca só cor), logo depois do título; o
// formulário não aparece em evento cancelado, adiado ou realizado e, no lugar, vai a frase curta. O bloco "Como participar" fica no HTML mesmo assim (só
// escondido): se a diretoria reativar ou remarcar o evento, a ilha `evento-vivo` o devolve na hora, sem esperar o site ser reconstruído.
export async function getStaticPaths() {
  const { eventos, projetos, documentos, detalhesDeEventos, noticias } =
    await conteudoPublico()
  const idsDeEventos = eventos.map((e) => e.id_evento)
  return eventos.map((evento) => {
    const detalhe = detalhesDeEventos[evento.id_evento]!
    return {
      params: { id: String(evento.id_evento) },
      props: {
        evento: {
          ...detalhe,
          // Só o que tem página no site vira link (nunca um 404).
          projeto: projetos.some(
            (p) => p.id_projeto === detalhe.projeto?.id_projeto,
          )
            ? detalhe.projeto
            : null,
          edicoes: soComPagina(detalhe.edicoes, idsDeEventos),
          documentos: soDocumentosPublicados(detalhe.documentos, documentos),
        },
        noticias: noticiasDoEvento(noticias, evento.id_evento),
      },
    }
  })
}

interface Props {
  evento: EventoDetalhado
  noticias: NoticiaPublica[]
}
const { evento, noticias } = Astro.props

const caminho = caminhoDoEvento(evento.id_evento)
const migalhas: Migalha[] = [
  { rotulo: 'Eventos', href: '/eventos/' },
  { rotulo: tituloCurto(evento.titulo) },
]
// O sistema só guarda o local quando o evento tem endereço próprio. Sem ele NÃO se presume a sede
// (o evento pode ser online ou em outro lugar): a página manda falar com a secretaria.
const local =
  evento.endereco_avulso?.trim() || 'A confirmar: fale com a secretaria.'
const quando = quandoEmPartes(evento.data_hora_inicio, evento.data_hora_fim)
const situacao = situacaoDoEvento(evento)
const aviso = avisoDaSituacao(evento)
const parado = inscricoesParadas(situacao.status)
const fraseParada = fraseDeInscricaoParada(situacao.status)
const reserva = `${evento.titulo} — ${formatarDia(evento.data_hora_inicio)}, ${formatarHora(evento.data_hora_inicio)}. Evento da ${ORGANIZACAO.nome} (${ORGANIZACAO.sigla}).`
const fimDoEvento = evento.data_hora_fim ?? evento.data_hora_inicio
const comoParticipar = jaAconteceu(fimDoEvento)
  ? 'nenhum'
  : !evento.gratuito
    ? 'com-valor'
    : pedeArquivo(evento.perguntas)
      ? 'com-arquivo'
      : 'formulario'

let vagasTexto: string | null = null
if (evento.vagas_livres !== null) {
  vagasTexto =
    evento.vagas_livres === 0
      ? 'Vagas esgotadas'
      : evento.vagas_livres === 1
        ? '1 vaga disponível'
        : `${evento.vagas_livres} vagas disponíveis`
}
---

<Base
  titulo={tituloCurto(evento.titulo)}
  descricao={descricaoParaMeta(evento.descricao, reserva)}
  caminho={caminho}
  migalhas={migalhas}
  jsonLd={[jsonLdEvento(evento, `${SITE_URL}${caminho}`)]}
>
  <TituloDePagina titulo={evento.titulo} migalhas={migalhas} />

  <div
    class="mx-auto flex max-w-5xl flex-col gap-10 px-4 py-12"
    data-evento-vivo
    data-id={evento.id_evento}
    data-api-url={API_URL}
    data-fim={fimDoEvento}
    data-status={situacao.status}
  >
    <div
      data-aviso-situacao
      data-situacao-do-evento={situacao.status}
      data-evento-remarcado={situacao.remarcado ? '' : undefined}
      role="status"
      hidden={aviso === null}
      class={CLASSES_DO_AVISO[aviso?.selo ?? 'Realizado']}
    >
      <p data-situacao-frase class="text-lg font-bold">
        {aviso?.frase}
      </p>
      <p data-situacao-motivo hidden={!aviso?.motivo} class="mt-2">
        {aviso?.motivo}
      </p>
      <p data-situacao-complemento hidden={!aviso?.complemento} class="mt-2">
        {aviso?.complemento}
      </p>
    </div>
    <p
      data-aviso-retirado
      hidden
      role="status"
      class="rounded-lg border-2 border-destructive p-4 font-medium"
    >
      Este evento foi retirado da programação. Fale com a secretaria para mais
      informações.
    </p>
    <p
      data-aviso-realizado
      hidden
      role="status"
      class="rounded-lg border bg-muted p-4 font-medium"
    >
      A data deste evento já passou.
    </p>

    {evento.projeto && (
      <p class="text-lg" data-projeto-do-evento>
        Faz parte do projeto{' '}
        <a
          href={caminhoDoProjeto(evento.projeto.id_projeto)}
          class="font-medium text-primary underline underline-offset-4"
        >
          {evento.projeto.nome}
        </a>
      </p>
    )}

    <section aria-labelledby="quando-onde">
      <h2 id="quando-onde" class="sr-only">
        Data, horário e local
      </h2>
      <dl class="grid max-w-3xl gap-x-8 gap-y-4 sm:grid-cols-[auto_1fr]">
        <dt class="font-medium">Quando</dt>
        <dd data-quando>
          <time datetime={quando.inicio.iso}>{quando.inicio.texto}</time>
          {quando.fim && (
            <>
              {' '}
              até <time datetime={quando.fim.iso}>{quando.fim.texto}</time>
            </>
          )}
        </dd>
        <dt class="font-medium">Onde</dt>
        <dd>{local}</dd>
        <dt class="font-medium">Entrada</dt>
        <dd>{evento.gratuito ? 'Gratuita' : 'Paga'}</dd>
        {vagasTexto && (
          <>
            <dt data-vagas-rotulo hidden={parado} class="font-medium">
              Vagas
            </dt>
            <dd data-vagas hidden={parado}>
              {vagasTexto}
            </dd>
          </>
        )}
      </dl>
    </section>

    {evento.descricao && (
      <section aria-labelledby="sobre">
        <h2 id="sobre" class="text-2xl font-bold tracking-tight">
          Sobre o evento
        </h2>
        <p class="mt-4 max-w-3xl whitespace-pre-line leading-relaxed">
          {evento.descricao}
        </p>
      </section>
    )}

    {evento.sessoes.length > 0 && (
      <section aria-labelledby="programacao">
        <h2 id="programacao" class="text-2xl font-bold tracking-tight">
          Programação
        </h2>
        <ol class="mt-4 flex max-w-3xl flex-col gap-3">
          {evento.sessoes.map((sessao) => (
            <li class="rounded-lg border bg-card p-4 shadow-card">
              <p class="text-sm font-medium text-primary">
                <time
                  datetime={comFusoDaAsaf(sessao.data_hora_inicio)}
                  data-sessao-horario={sessao.id_sessao}
                >
                  {formatarDia(sessao.data_hora_inicio)},{' '}
                  {formatarHora(sessao.data_hora_inicio)}
                </time>
              </p>
              <h3 class="mt-1 font-semibold">{sessao.titulo}</h3>
              {sessao.descricao && (
                <p class="mt-1 text-sm">{sessao.descricao}</p>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}

    {evento.documentos.length > 0 && (
      <RelatoriosEDocumentos
        id="relatorio-e-documentos"
        titulo="Relatório e documentos"
        documentos={evento.documentos}
      />
    )}

    {evento.fotos.length > 0 && (
      <GaleriaDeFotos
        id="fotos-do-evento"
        titulo="Fotos do evento"
        fotos={evento.fotos}
      />
    )}

    {noticias.length > 0 && (
      <NoticiasRelacionadas
        id="noticias-do-evento"
        titulo="Notícias sobre este evento"
        noticias={noticias}
      />
    )}

    {evento.edicoes.length > 1 && (
      <EdicoesEEventos
        id="outras-edicoes"
        titulo="Outras edições"
        eventos={evento.edicoes}
      />
    )}

    <p
      data-inscricoes-paradas
      hidden={fraseParada === null}
      class="rounded-lg border bg-muted p-4 font-medium"
    >
      {fraseParada}
    </p>

    {comoParticipar !== 'nenhum' && (
      <div data-como-participar hidden={parado}>
        {comoParticipar === 'formulario' ? (
          <FormularioDeInscricao evento={evento} />
        ) : (
          <FaleConosco titulo="Como participar">
            <p>
              {comoParticipar === 'com-valor'
                ? 'Este evento tem inscrição com valor, que o formulário do site ainda não cobra. Fale com a secretaria para saber como participar.'
                : 'Este evento pede o envio de um arquivo na inscrição, e o formulário do site ainda não recebe arquivos. Fale com a secretaria para saber como participar.'}
            </p>
          </FaleConosco>
        )}
      </div>
    )}

    <p>
      <a
        href="/eventos/"
        class="font-medium text-primary underline underline-offset-4"
      >
        ← Toda a agenda
      </a>
    </p>
  </div>
</Base>

<script>
  import { iniciarEventoVivo } from '../../../lib/evento-vivo'

  document
    .querySelectorAll<HTMLElement>('[data-evento-vivo]')
    .forEach((raiz) => void iniciarEventoVivo(raiz))
</script>
