{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/servir-teste.mjs",
      "startServerReadyPattern": "PRONTO_PARA_TESTE",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://127.0.0.1:4321/",
        "http://127.0.0.1:4321/quem-somos/",
        "http://127.0.0.1:4321/seja-associado/",
        "http://127.0.0.1:4321/estatuto/",
        "http://127.0.0.1:4321/contato/",
        "http://127.0.0.1:4321/diretoria/",
        "http://127.0.0.1:4321/eventos/2/",
        "http://127.0.0.1:4321/noticias/",
        "http://127.0.0.1:4321/noticias/noticia-de-teste-com-foto/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
