{
  "name": "asaf-site",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/gerar-version.js",
    "dev": "astro dev",
    "prebuild": "node scripts/gerar-version.js",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "logos": "node scripts/gerar-logos.mjs",
    "og": "node scripts/gerar-og.mjs",
    "build:teste": "node scripts/gerar-version.js && node scripts/build-teste.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
