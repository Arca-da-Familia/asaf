{
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "routes": [
    {
      "route": "/_astro/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/version.json",
      "headers": { "cache-control": "no-store" }
    },
    {
      "route": "/conteudo.json",
      "headers": { "cache-control": "no-store" }
    }
  ]
}
