# v8.5 (FASE 8) - os GATILHOS DE ESCALA: quando um destes números for passado, é hora de crescer (ou de revisar). A rotina "Revisão de desempenho"
# (.github/workflows/revisao-de-desempenho.yml, a cada 3 meses) mede o período e abre um aviso no GitHub se algum for atingido; o que fazer em cada caso
# está no RUNBOOK.md, seção 11. Os valores partem do uso REAL medido em 2026-11-03 (30 dias de produção), registrado ao lado de cada um.
# Uma variável por linha, NOME=valor (números inteiros).

# Banco (Postgres B1ms: 1 vCPU, 2 GiB). Medido: CPU média por hora 8,2% (95% das horas abaixo de 10,9%); um pico isolado de 99,9% em 06/10.
# Gatilho: a média horária passou de 60% em mais de 5% das horas do período -> subir de B1ms para B2s.
BANCO_CPU_MEDIA_HORARIA_MAX=60
BANCO_HORAS_ACIMA_PERCENTUAL_MAX=5
# Medido: memória média 55% (95% das horas abaixo de 57,8%), pico 89,6%. Gatilho: média horária acima de 85% em mais de 5% das horas.
BANCO_MEMORIA_MEDIA_HORARIA_MAX=85
# Medido: os créditos de CPU (o "fôlego" do plano Burstable) ficaram entre 301 e 312 o mês todo. Se caírem abaixo disto, o banco está sem fôlego.
BANCO_CREDITOS_CPU_MIN=100
# Medido: média 9,8 conexões, pico 33. Limite prático: 35 (50 do servidor menos 15 reservadas pelo Azure). Gatilho: pico acima de 28 (80%).
BANCO_CONEXOES_PICO_MAX=28
# Medido: 13,4% dos 32 GB (4,4 GB), crescendo uns 57 MB por mês. Gatilho: 70% -> aumentar o disco (só cresce, não diminui) ou revisar a retenção.
BANCO_DISCO_PERCENTUAL_MAX=70

# API de produção (Container App, até 2 cópias de 0,5 CPU e 1 GiB). Medido: 0,21 cópia em média (dorme sem uso), pico 2; 7.951 pedidos no mês, pico 290 numa
# hora; memória até 292 MB; nenhum reinício. Gatilho: o número máximo de cópias ficou atingido em mais de 10% das horas -> subir o máximo (refazendo a conta
# das conexões, tests/test_orcamento_de_conexoes.py).
API_HORAS_NO_MAXIMO_PERCENTUAL_MAX=10
API_MEMORIA_PERCENTUAL_MAX=80
API_REINICIOS_MAX=3

# Arquivos (conta stasafprivado). Medido: menos de 1 MB. Gatilho: 50 GB -> revisar a retenção (custo).
ARQUIVOS_GB_MAX=50

# Consultas (pg_stat_statements e estatísticas das tabelas). Gatilho: consulta com média acima de 500 ms chamada mais de 100 vezes; tabela com mais de
# 5.000 linhas lida mais vezes por varredura completa do que por índice.
CONSULTA_MEDIA_MS_MAX=500
CONSULTA_CHAMADAS_MIN=100
TABELA_LINHAS_PARA_INDICE=5000
