# Copie para .env.local (gitignored) se precisar apontar para outra API.
# Em dev deixe vazio: o Vite faz proxy de /auth para http://localhost:8000.
# Em produção, defina a origem da API (mesmo site do painel para o cookie
# SameSite=Strict funcionar — ex.: https://api.asaf.org.br).
VITE_API_URL=

# v0.2.7 — connection string do Application Insights (`asaf-appinsights`, já provisionado na
# v0.0) para telemetria de erro do front. Não é segredo (é feita para ir embutida no bundle
# público), mas fica vazia por padrão: sem ela, o monitoramento vira no-op (só console.error
# local) e nada quebra. Preencher em produção quando alguém for ativar isso de verdade.
VITE_APPINSIGHTS_CONNECTION_STRING=
