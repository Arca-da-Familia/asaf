{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{png,ico,webp}", "/version.json"]
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/version.json",
      "headers": { "cache-control": "no-store" }
    },
    {
      "route": "/index.html",
      "headers": { "cache-control": "no-cache" }
    }
  ]
}
