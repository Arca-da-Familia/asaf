# Segredos e credenciais — cifrados com SOPS (age) e versionados de forma segura.
# A chave PRIVADA age fica em %APPDATA%\sops\age\keys.txt e NUNCA é versionada.
# Estes arquivos sobem CIFRADOS (o texto puro é local e nunca deve ser commitado):
#   .env · CREDENCIAIS_AZURE.md · infra/provisionar.sh
.env.*
!.env.example
*.pem
*.key

# Banco de dados local / dados reais
*.db
*.sqlite
*.sqlite3
uploads/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Logs e processos locais
*.log
uvicorn_app_pid.txt

# Node (front-end quando existir)
node_modules/
dist/
.astro/

# Editor
.vscode/
.idea/

# Claude Code (config local da ferramenta, não é código do projeto)
.claude/
